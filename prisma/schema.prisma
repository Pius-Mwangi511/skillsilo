generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ConsultationStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum NotificationType {
  SYSTEM
  SILO
  CONSULTATION
}

//////////////////////
// USER & AUTH
//////////////////////

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String
  password    String
  bio         String?
  profileImage String? 
  experience  ExperienceLevel?
  skills      String[]
  role        Role     @default(MEMBER) 
  isVerified  Boolean  @default(false)  
  createdAt   DateTime @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?  // soft delete

  memberships   Membership[]
  messages      Message[]
  assessments   SkillAssessment[]
  submissions   Submission[]
  notifications Notification[]
  reports       Report[]

  Feedback Feedback[]
  crossSiloRequests CrossSiloRequest[]
  crossSiloReplies  CrossSiloReply[]


  AuthToken AuthToken[]

  Resource Resource[]

  PeerReview PeerReview[]

  Challenge Challenge[]
}

//////////////////////
// SILOS
//////////////////////

model Silo {
  id        String   @id @default(uuid())
  skill     String
  level     ExperienceLevel
  createdBy String
  createdAt DateTime @default(now())

  memberships   Membership[]
  messages      Message[]
  challenges    Challenge[]
  resources     Resource[]

  sentConsultations     ConsultationRequest[] @relation("FromSilo")
  receivedConsultations ConsultationRequest[] @relation("ToSilo")

  Feedback Feedback[]
}

//////////////////////
// MEMBERSHIP
//////////////////////

model Membership {
  id     String @id @default(uuid())
  role   Role
  userId String
  siloId String

  user User @relation(fields: [userId], references: [id])
  silo Silo @relation(fields: [siloId], references: [id])

  @@unique([userId, siloId])
}

//////////////////////
// MESSAGES & MODERATION
//////////////////////

model Message {
  id        String   @id @default(uuid())
  content   String
  userId    String
  siloId    String
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  silo     Silo      @relation(fields: [siloId], references: [id])
  feedback Feedback[]
  reports  Report[]
}

model Feedback {
  id        String   @id @default(uuid())
  message   String
  rating    Int?

  userId    String
  siloId    String

  user      User     @relation(fields: [userId], references: [id])
  silo      Silo     @relation(fields: [siloId], references: [id])

  createdAt DateTime @default(now())

  Message Message[]
}

model Report {
  id        String   @id @default(uuid())
  reason    String
  userId    String
  messageId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  message Message? @relation(fields: [messageId], references: [id])
}

//////////////////////
// SKILL ASSESSMENT
//////////////////////

model SkillAssessment {
  id        String           @id @default(uuid())
  userId    String
  skill     String
  level     ExperienceLevel
  verified  Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

//////////////////////
// CHALLENGES & SUBMISSIONS
//////////////////////

model Challenge {
  id          String   @id @default(uuid())
  title       String
  description String
  siloId      String
  createdBy   String
  dueDate     DateTime?
  createdAt   DateTime @default(now())

  silo        Silo @relation(fields: [siloId], references: [id])
  creator     User @relation(fields: [createdBy], references: [id])

  submissions Submission[]
}

model Submission {
  id          String   @id @default(uuid())
  challengeId String
  userId      String
  content     String
  resourceUrl String?
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  reviews   PeerReview[]
}

model PeerReview {
  id           String   @id @default(uuid())
  submissionId String
  reviewerId   String
  score        Int
  comment      String?
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   User       @relation(fields: [reviewerId], references: [id])
}
//////////////////////
// RESOURCES
//////////////////////

model Resource {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  fileType  String
  siloId    String
  userId    String
  createdAt DateTime @default(now())

  silo Silo @relation(fields: [siloId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

//////////////////////
// CONSULTATIONS
//////////////////////

model ConsultationRequest {
  id            String               @id @default(uuid())
  fromSiloId    String
  toSiloId      String?
  description   String 
  responseMessage String? 
  status        ConsultationStatus
  respondedAt     DateTime? 
  createdAt     DateTime             @default(now())

  fromSilo Silo @relation("FromSilo", fields: [fromSiloId], references: [id])
  toSilo   Silo? @relation("ToSilo", fields: [toSiloId], references: [id])
}

//////////////////////
// NOTIFICATIONS
//////////////////////

model Notification {
  id        String   @id @default(uuid())
  message   String
  isRead    Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
model AuthToken {
  id         String     @id @default(uuid())
  token      String     @unique
  userId     String
  type       TokenType
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id])
}

//////////////////////
// CROSS-SILO COMMUNICATION
//////////////////////

model CrossSiloRequest {
  id         String   @id @default(uuid())
  title      String
  content    String

  fromUserId String?
  fromUser   User?     @relation(fields: [fromUserId], references: [id])

  createdAt  DateTime @default(now())

  replies    CrossSiloReply[]
}

model CrossSiloReply {
  id         String   @id @default(uuid())
  message    String

  requestId  String
  request    CrossSiloRequest @relation(fields: [requestId], references: [id])

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now())
}


enum TokenType {
  RESET_PASSWORD
  VERIFY_EMAIL
}
